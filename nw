                price: 68000, 
                image: "https://www.bmwusa.com/content/dam/bmw/common/vehicles/2023/my24/i4/gran-coupe/i4-edrive35/BMW-MY24-i4-eDrive35-Gallery-01.jpg", 
                hp: 335, 
                mpg: 109, // MPGe for electric
                features: ["All-Electric", "Curved Display", "BMW Live Cockpit", "Harman Kardon Audio"],
                country: "German"
            }
        ];

        // Theme toggle functionality
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = themeToggle.querySelector('i');
        
        // Check for saved theme preference or default to dark
        const currentTheme = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', currentTheme);
        
        // Update icon based on current theme
        if (currentTheme === 'light') {
            themeIcon.classList.remove('fa-moon');
            themeIcon.classList.add('fa-sun');
        }
        
        themeToggle.addEventListener('click', () => {
            // Toggle between dark and light themes
            const currentTheme = document.documentElement.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            
            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            
            // Update icon
            if (newTheme === 'light') {
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
            } else {
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
            }
        });

        // Function to display new arrival cars
        function displayNewArrivals(filteredCars = newArrivals) {
            const newArrivalsGrid = document.getElementById('newArrivalsGrid');
            newArrivalsGrid.innerHTML = '';
            
            if (filteredCars.length === 0) {
                newArrivalsGrid.innerHTML = '<p style="text-align: center; grid-column: 1 / -1; padding: 40px;">No new arrivals found matching your criteria.</p>';
                return;
            }
            
            filteredCars.forEach(car => {
                const carCard = document.createElement('div');
                carCard.className = 'car-card';
                carCard.setAttribute('data-type', car.type);
                carCard.setAttribute('data-brand', car.brand);
                carCard.setAttribute('data-price', car.price);
                
                carCard.innerHTML = `
                    <div class="new-badge">NEW</div>
                    <div class="car-img">
                        <img src="${car.image}" alt="${car.name}">
                        <div class="car-country">${car.country}</div>
                        <div class="car-type">${car.type.charAt(0).toUpperCase() + car.type.slice(1)}</div>
                    </div>
                    <div class="car-content">
                        <div class="car-brand">${getBrandName(car.brand)}</div>
                        <h3 class="car-name">${car.name}</h3>
                        <div class="car-price">$${car.price.toLocaleString()}</div>
                        <div class="car-features">
                            <div class="car-feature">
                                <i class="fas fa-tachometer-alt"></i>
                                <span>${car.hp} HP</span>
                            </div>
                            <div class="car-feature">
                                <i class="fas fa-gas-pump"></i>
                                <span>${car.mpg} ${car.features.some(f => f.includes('Electric')) ? 'MPGe' : 'MPG'}</span>
                            </div>
                        </div>
                        <div class="car-actions">
                            <div class="car-action view-details">View Details</div>
                            <div class="car-action add-to-garage">Add to Garage</div>
                        </div>
                    </div>
                `;
                
                newArrivalsGrid.appendChild(carCard);
            });
            
            // Add event listeners to action buttons
            document.querySelectorAll('.view-details').forEach(button => {
                button.addEventListener('click', (e) => {
                    e.preventDefault();
                    const carName = button.closest('.car-card').querySelector('.car-name').textContent;
                    alert(`Viewing details for ${carName}`);
                });
            });
            
            document.querySelectorAll('.add-to-garage').forEach(button => {
                button.addEventListener('click', (e) => {
                    e.preventDefault();
                    const carName = button.closest('.car-card').querySelector('.car-name').textContent;
                    alert(`${carName} added to your garage!`);
                });
            });
        }
        
        // Helper function to get brand name from brand code
        function getBrandName(brandCode) {
            const brandNames = {
                toyota: "Toyota",
                honda: "Honda",
                bmw: "BMW",
                mercedes: "Mercedes-Benz",
                audi: "Audi"
            };
            return brandNames[brandCode] || brandCode;
        }
        
        // Brand tabs functionality
        const brandTabs = document.querySelectorAll('.brand-tab');
        
        brandTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                // Remove active class from all tabs
                brandTabs.forEach(t => t.classList.remove('active'));
                // Add active class to clicked tab
                tab.classList.add('active');
                
                // Get the brand from data attribute
                const brand = tab.getAttribute('data-brand');
                
                // Filter cars based on brand
                let filteredCars = newArrivals;
                if (brand !== 'all') {
                    filteredCars = newArrivals.filter(car => car.brand === brand);
                }
                
                // Apply additional filters if any
                filteredCars = applyAdditionalFilters(filteredCars);
                
                // Display filtered cars
                displayNewArrivals(filteredCars);
            });
        });
        
        // Function to apply additional filters (type, price)
        function applyAdditionalFilters(carsArray) {
            const modelFilter = document.getElementById('modelFilter').value;
            const priceFilter = document.getElementById('priceFilter').value;
            
            let filtered = carsArray;
            
            // Filter by type
            if (modelFilter !== 'all') {
                filtered = filtered.filter(car => car.type === modelFilter);
            }
            
            // Filter by price
            if (priceFilter !== 'all') {
                switch(priceFilter) {
                    case 'under40':
                        filtered = filtered.filter(car => car.price < 40000);
                        break;
                    case '40-60':
                        filtered = filtered.filter(car => car.price >= 40000 && car.price <= 60000);
                        break;
                    case '60-80':
                        filtered = filtered.filter(car => car.price >= 60000 && car.price <= 80000);
                        break;
                    case 'over80':
                        filtered = filtered.filter(car => car.price > 80000);
                        break;
                }
            }
            
            return filtered;
        }
        
        // Add event listeners to filter dropdowns
        document.getElementById('modelFilter').addEventListener('change', updateFilters);
        document.getElementById('priceFilter').addEventListener('change', updateFilters);
        
        // Function to update filters when dropdowns change
        function updateFilters() {
            const activeTab = document.querySelector('.brand-tab.active');
            const brand = activeTab.getAttribute('data-brand');
            
            let filteredCars = newArrivals;
            if (brand !== 'all') {
                filteredCars = newArrivals.filter(car => car.brand === brand);
            }
            
            filteredCars = applyAdditionalFilters(filteredCars);
            displayNewArrivals(filteredCars);
        }
        
        // Initialize the page with all new arrivals
        displayNewArrivals();
    </script>
