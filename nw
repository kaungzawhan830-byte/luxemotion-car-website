                price: 36500, 
                image: "https://automobiles.honda.com/-/media/Honda-Automobiles/Vehicles/2024/CR-V-Hybrid/Gallery/01-exterior/2024-CR-V-Hybrid-Sport-Touring-Exterior-04-1600.jpg", 
                hp: 204, 
